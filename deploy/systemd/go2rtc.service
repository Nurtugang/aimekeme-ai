# Живое видео для оператора (RTSP -> WebRTC), мимо AI. Потоки регистрирует
# сам backend (vision/platform/go2rtc/README.md).
[Unit]
Description=go2rtc live video
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
WorkingDirectory=/opt/vision/platform/go2rtc
ExecStart=/opt/vision/platform/go2rtc/go2rtc -config /opt/vision/platform/go2rtc/go2rtc.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
