# -> /etc/aimekeme/ai-g0b.env. GPU0, второй процесс: под полной нагрузкой
# (23 камеры, все модули) fight/fire/counting в одном ai-g0 ждали очереди к
# модели 30-50 мс (p95) при GPU0 занятой на 30% — упор в процесс, а не в
# карту (SCALING_TZ.md §3). Базу лиц он не пишет — только ai-g0 (nginx).
CUDA_VISIBLE_DEVICES=0
PORT=8103
DEVICE=cuda
