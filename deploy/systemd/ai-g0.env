# -> /etc/aimekeme/ai-g0.env. GPU0: основной для fight и fire, резерв для
# face/counting/persons, единственный писатель базы лиц (docs/SCALING_TZ.md §5.2).
CUDA_VISIBLE_DEVICES=0
PORT=8100
# Явно cuda, не auto: если карта не поднялась, процесс не стартует (R7),
# а не уезжает молча на CPU.
DEVICE=cuda
